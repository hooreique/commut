{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "cp-xterm-css": "mkdir -p build && cp node_modules/@xterm/xterm/css/xterm.css build/xterm.css",
    "build-fe": "tsdown --no-clean --sourcemap --out-dir=build src/app.ts",
    "prepare": "unocss && pnpm run cp-xterm-css && pnpm run build-fe",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@unocss/cli": "66.5.10",
    "@unocss/reset": "66.5.10",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "tsdown": "0.18.2",
    "unocss": "66.5.10"
  }
}
