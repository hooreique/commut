{
  "entry": "src/app.ts",
  "deps": {
    "onlyBundle": [
      "@xterm/xterm",
      "@xterm/addon-webgl"
    ]
  },
  "tsconfig": "tsconfig.runtime.json",
  "outDir": "dist",
  "sourcemap": true,
  "clean": false,
  "hash": true,
  "outputOptions": {
    "entryFileNames": "[name].[hash].mjs",
    "chunkFileNames": "[name].[hash].mjs"
  }
}
