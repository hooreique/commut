{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "include": [
    "build-src",
    "uno.config.ts",
  ],
  "compilerOptions": {
    "composite": true,
    "rootDir": "build-src",
    "noEmit": true,
    "lib": [
      "ESNext",
    ],
    "types": [
      "node",
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
  },
}
