$domain {
  handle_path /app/* {
    header Cache-Control "no-cache"
    root * "$client_root/build/app"
    file_server
  }

  @public path /favicon.ico /manifest.json /images/* /fonts/*

  handle @public {
    root * "$client_root/public"
    file_server
  }

  handle_path /dist/* {
    header Cache-Control "public, max-age=31536000, immutable"
    root * "$client_root/dist"
    file_server
  }

  handle /api/* {
    reverse_proxy $upstream
  }

  handle /sockets/* {
    reverse_proxy $upstream
  }

  handle {
    respond "404 Not Found" 404
  }
}
